{
  "name": "wp-sidebar-editor",
  "version": "0.3.0",
  "private": true,
  "description": "Edit WordPress pages, posts and custom fields from the browser side panel without opening wp-admin.",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode chrome",
    "dev:firefox": "vite build --watch --mode firefox",
    "build": "npm run build:chrome && npm run build:firefox",
    "build:chrome": "vite build --mode chrome",
    "build:firefox": "vite build --mode firefox",
    "zip": "npm run build && node scripts/zip.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build",
    "test:php": "php tests/php/run.php",
    "test:e2e": "node tests/e2e/smoke.e2e.mjs",
    "test:e2e:wp": "node tests/e2e/real-wp.e2e.mjs",
    "test:integration": "node tests/integration/bridge.integration.mjs",
    "zip:plugin": "node scripts/zip-plugin.mjs"
  },
  "dependencies": {
    "imask": "^7.6.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/node": "^22.20.5",
    "jsdom": "^30.1.2",
    "playwright": "^1.56.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  }
}
